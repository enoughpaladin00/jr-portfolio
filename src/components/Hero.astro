---
import { content, links, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="flex flex-wrap items-start gap-12 py-16 sm:py-24" aria-labelledby="hero-name">
  <div class="min-w-0 flex-[999_1_560px]">
    <p class="mb-5 font-mono text-[15px] text-muted"><span class="text-accent" aria-hidden="true">$</span> whoami</p>
    <h1 id="hero-name" class="font-mono text-[clamp(2.6rem,6.5vw,5.4rem)] leading-[1.02] font-bold tracking-[-0.03em]">
      Jacopo Rossi<span class="cursor text-accent" aria-hidden="true"></span>
    </h1>
    <p class="mt-5 font-mono text-[17px] text-accent">{t.role}</p>
    <p class="mt-6 max-w-[600px] text-[19px] leading-relaxed text-body">{t.pitch}</p>

    <div class="mt-9 flex flex-wrap gap-3.5">
      <a
        href={links.cv}
        download
        class="inline-flex min-h-12 items-center gap-2.5 rounded bg-accent px-5.5 font-mono text-[15px] font-bold text-ink no-underline hover:bg-[#f6ca76] hover:text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path>
        </svg>
        {t.ctaCv}
      </a>
      <a
        href="#projects"
        class="inline-flex min-h-12 items-center rounded border border-line-strong px-5.5 font-mono text-[15px] text-fg no-underline hover:border-accent hover:text-accent"
      >
        {t.ctaProjects} →
      </a>
    </div>

    <p class="mt-7 flex items-center gap-2.5 font-mono text-sm text-muted">
      <span class="inline-block size-2 rounded-full bg-ok" aria-hidden="true"></span>{t.status}
    </p>
  </div>

  <div class="min-w-0 flex-[1_1_340px] rounded-md border border-line bg-panel font-mono text-sm">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3 text-muted">
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="ml-2">sysinfo</span>
    </div>
    <dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4.5 gap-y-2.5 px-5 pt-5 pb-5.5 leading-normal">
      {
        t.sys.map((row) => (
          <>
            <dt class="text-accent">{row.k}</dt>
            <dd class="text-fg">{row.v}</dd>
          </>
        ))
      }
    </dl>
  </div>
</section>
