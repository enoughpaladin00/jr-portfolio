---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-[1180px] flex-wrap justify-between gap-3 px-5 py-6 font-mono text-[13px] text-muted sm:px-8">
    <span>© {year} Jacopo Rossi</span>
    <span>
      {content[lang].footer.replace('Astro', '')}<a href="https://astro.build" class="text-muted hover:text-accent">Astro</a>
    </span>
  </div>
</footer>
