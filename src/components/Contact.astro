---
import { content, links, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].contact;
const cards = [
  { k: 'email', v: links.email, href: `mailto:${links.email}` },
  { k: 'linkedin', v: 'in/jacopo-rossi ↗', href: links.linkedin },
  { k: 'github', v: 'enoughpaladin00 ↗', href: links.github },
  { k: 'hack the box', v: 'Enoughpaladin00 ↗', href: links.htb },
];
---

<section id="contact" class="border-t border-line pt-22 pb-24" aria-labelledby="contact-title">
  <p class="mb-2 font-mono text-[15px] text-muted"><span class="text-accent" aria-hidden="true">$</span> ./contact --now</p>
  <h2 id="contact-title" class="font-mono text-[clamp(2rem,4.5vw,3.4rem)] leading-[1.1] tracking-[-0.03em]">{t.title}</h2>
  <p class="mt-5 max-w-[560px] text-[19px] text-body">{t.text}</p>
  <ul class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-3 font-mono text-[15px]">
    {
      cards.map((c) => (
        <li>
          <a
            href={c.href}
            class="flex min-h-11 flex-col gap-1 rounded border border-line-strong px-5 py-4.5 break-all text-fg no-underline hover:border-accent hover:text-accent"
          >
            <span class="text-[13px] text-muted">{c.k}</span>
            <span>{c.v}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
