---
import { content, links, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="flex flex-wrap items-start gap-12 py-16 sm:py-24" aria-labelledby="hero-name">
  <div class="min-w-0 flex-[999_1_560px]">
    <p class="mb-5 font-mono text-[15px] text-muted">
      <span class="text-accent" aria-hidden="true">$</span> <span class="typed">whoami</span>
    </p>
    <h1
      id="hero-name"
      class="rise text-[clamp(3.2rem,8vw,6.6rem)] leading-[0.95] font-extrabold tracking-[-0.045em]"
      style="--i: 0"
    >
      Jacopo Rossi<span class="cursor text-accent" aria-hidden="true"></span>
    </h1>
    <p class="rise mt-6 font-mono text-[16px] text-accent" style="--i: 1">{t.role}</p>
    <p class="rise mt-6 max-w-[600px] text-[20px] leading-relaxed text-body" style="--i: 2">{t.pitch}</p>

    <div class="rise mt-9 flex flex-wrap gap-3.5" style="--i: 3">
      <a
        href={links.cv}
        download
        class="press inline-flex min-h-12 items-center gap-2.5 rounded bg-accent px-5.5 font-mono text-[15px] text-ink no-underline hover:bg-[#f6ca76] hover:text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path>
        </svg>
        {t.ctaCv}
      </a>
      <a
        href="#projects"
        class="press btn-arrow inline-flex min-h-12 items-center gap-2 rounded border border-line-strong px-5.5 font-mono text-[15px] text-fg no-underline hover:border-accent hover:text-accent"
      >
        {t.ctaProjects} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <p class="rise mt-7 flex items-center gap-2.5 font-mono text-sm text-muted" style="--i: 4">
      <span class="relative inline-flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-60 motion-reduce:hidden"></span>
        <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
      </span>
      {t.status}
    </p>
  </div>

  <div class="rise min-w-0 flex-[1_1_340px] rounded-md border border-line bg-panel font-mono text-sm" style="--i: 3">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3 text-muted">
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
      <span class="ml-2">sysinfo</span>
    </div>
    <dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4.5 gap-y-2.5 px-5 pt-5 pb-5.5 leading-normal">
      {
        t.sys.map((row) => (
          <>
            <dt class="text-accent">{row.k}</dt>
            <dd class="text-fg">{row.v}</dd>
          </>
        ))
      }
    </dl>
  </div>
</section>
